
# Application Configuration
APP_NAME="3-Tier Banking Agent API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false

# API Configuration
API_V1_PREFIX="/api/v1"

# Logging Configuration
LOG_LEVEL="INFO"

# CORS Configuration
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_agent_db
DB_USER=banking_app
DB_PASSWORD="YOUR_ACTUAL_PASSWORD"