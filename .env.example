
# Application Configuration
APP_NAME="3-Tier Banking Agent API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false

# API Configuration
API_V1_PREFIX="/api/v1"

# Logging Configuration
LOG_LEVEL="INFO"

# CORS Configuration
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600
AUTH_COOKIE_SECURE=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_agent_db
DB_USER=banking_app
DB_PASSWORD="YOUR_ACTUAL_PASSWORD"

# JWT Security Configuration
# Generate a secret using secrets.token_hex(32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=banking-agent-api
JWT_AUDIENCE=banking-agent-client

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
AUTH_LOGOUT_RATE_LIMIT=30
AUTH_RATE_LIMIT_MAX_KEYS=10000